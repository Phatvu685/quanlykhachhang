# Root environment example for docker-compose
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password

# Backend
PORT=3001
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db?schema=public

# Frontend (Vercel will override this)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
